# ============ Blockchain ============
# Sepolia RPC URL (get free from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer wallet private key (for contract deployment only)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Deployed contract address (fill after deployment)
VITE_CONTRACT_ADDRESS=0x_YOUR_CONTRACT_ADDRESS

# ============ IPFS (Pinata) ============
# Get from https://app.pinata.cloud/developers/api-keys
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key

# ============ Network ============
# Sepolia Chain ID
VITE_CHAIN_ID=11155111
VITE_NETWORK_NAME=Sepolia
VITE_ETHERSCAN_URL=https://sepolia.etherscan.io
